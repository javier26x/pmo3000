# ---------------------------------------------------------------------------
# Desarrollo local con el Firebase Emulator Suite (no requiere proyecto real).
# Copia este archivo como .env y dejalo tal cual para trabajar con emuladores.
# ---------------------------------------------------------------------------
VITE_USAR_EMULADORES=true
VITE_FIREBASE_PROJECT_ID=demo-pmo3000
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pmo3000.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app-id

# Dominio corporativo permitido para iniciar sesion.
VITE_DOMINIO_PERMITIDO=claro.cl

# ---------------------------------------------------------------------------
# Para apuntar al proyecto real (nube), cambia a false y pega los valores que
# entrega la consola de Firebase en Configuracion del proyecto > Tus apps.
# VITE_USAR_EMULADORES=false
# VITE_FIREBASE_PROJECT_ID=pmo-despliegue
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=pmo-despliegue.firebaseapp.com
# VITE_FIREBASE_APP_ID=1:123456789:web:abc123
# ---------------------------------------------------------------------------
