# ---------------------------------------------------------------------------
# .env  ->  desarrollo con el Firebase Emulator Suite (no toca la nube).
# Copia este archivo como .env y déjalo tal cual para trabajar en local:
#   cp .env.example .env
# ---------------------------------------------------------------------------
VITE_USAR_EMULADORES=true
VITE_FIREBASE_PROJECT_ID=demo-pmo3000
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pmo3000.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app-id

# Dominios corporativos permitidos para iniciar sesión, separados por coma.
# Se valida también en firestore.rules (esCorreoCorporativo): cambiarlo solo
# aquí no autoriza a nadie.
VITE_DOMINIOS_PERMITIDOS=clarovtr.cl,claro.cl

# Tenant de Microsoft 365 (CLAROCHILE). Vacío: sin botón de Microsoft.
# Ver docs/ingreso-microsoft.md.
# VITE_MICROSOFT_TENANT=

# ---------------------------------------------------------------------------
# .env.production  ->  proyecto real. Lo usa `npm run build`, nunca `npm run dev`.
# Los valores salen de la consola de Firebase:
#   Configuración del proyecto > Tus apps > Configuración del SDK
# o con:  firebase apps:sdkconfig web --project produccion
#
# La configuración web de Firebase NO es secreta: viaja en el bundle de
# cualquier app web y así está diseñada. Lo que protege los datos son las
# reglas de Firestore.
# ---------------------------------------------------------------------------
# VITE_USAR_EMULADORES=false
# VITE_FIREBASE_PROJECT_ID=pmoclr
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=pmoclr.firebaseapp.com
# VITE_FIREBASE_APP_ID=1:311927873870:web:...
# VITE_FIREBASE_STORAGE_BUCKET=pmoclr.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=311927873870
# VITE_DOMINIO_PERMITIDO=clarovtr.cl
