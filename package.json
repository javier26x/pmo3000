{
  "name": "pmo3000",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PMO de despliegue de red movil - gestion de sitios por gates",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pmo3000 \"vitest run --config vitest.rules.config.ts\"",
    "test:rules:conectado": "vitest run --config vitest.rules.config.ts",
    "emu": "firebase emulators:start --project demo-pmo3000",
    "emu:persistente": "firebase emulators:start --project demo-pmo3000 --import ./.emulator-data --export-on-exit ./.emulator-data",
    "seed": "tsx scripts/seed.ts",
    "dev:full": "concurrently -k -n emuladores,app -c blue,green \"npm:emu\" \"npm:dev\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project produccion",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project produccion",
    "deploy": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting --project produccion"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@e965/xlsx": "^0.20.3",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-virtual": "^3.14.13",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.47.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.4.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
