rules_version = '2';

// ===========================================================================
// PMO3000 - Reglas de seguridad de Firestore
//
// Estas reglas son la AUTORIDAD. La matriz de src/domain/permisos/matriz.ts
// describe lo mismo para que la UI no ofrezca botones que van a fallar, pero un
// cliente manipulado no gana nada saltandose la matriz: aqui se decide.
//
// Limite conocido de la Fase 1: el lenguaje de reglas no recorre arreglos, asi
// que NO puede verificar que todos los entregables obligatorios de un gate esten
// cumplidos antes de avanzar. Eso lo valida la maquina de dominio en el cliente;
// en Fase 2 una Cloud Function lo valida del lado del servidor. Lo que si
// garantizan estas reglas es la secuencia de gates, los permisos por rol, la
// visibilidad acotada del contratista y que la auditoria sea inmutable.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function autenticado() {
      return request.auth != null && request.auth.uid != null;
    }

    function correo() {
      return request.auth.token.email;
    }

    /**
     * Correos externos autorizados, que además entran como administradores.
     *
     * Existe para resolver el arranque: alguien tiene que poder administrar la
     * instalación antes de que exista el primer administrador, y ese alguien
     * puede no tener cuenta corporativa.
     *
     * Esta lista es la que manda. Su espejo en el cliente es la variable
     * VITE_CORREOS_ADMIN; agregar un correo allá sin agregarlo aquí no autoriza
     * a nadie (entra y no puede leer nada).
     */
    function correosAdministradores() {
      return ['javier.neo@gmail.com'];
    }

    // Dominios de Claro: @clarovtr.cl, @e.clarovtr.cl y @claro.cl. Espejo en el cliente:
    // AJUSTES.dominiosPermitidos (VITE_DOMINIOS_PERMITIDOS). Sin mayusculas:
    // el token puede traer el correo como lo escribio el directorio.
    function esCorreoCorporativo() {
      return correo() is string && correo().lower().matches('^[^@]+@(clarovtr|e[.]clarovtr|claro)[.]cl$');
    }

    function esAdministradorInicial() {
      return correo() is string && correo() in correosAdministradores();
    }

    // Entra quien tenga correo corporativo o esté en la lista, y siempre con el
    // correo verificado. El enlace por correo y el ingreso con Google dejan
    // email_verified en true; el seed crea los usuarios de prueba igual de
    // verificados.
    function dominioValido() {
      return autenticado()
        && (esCorreoCorporativo() || esAdministradorInicial() || invitado())
        && correoConfiable();
    }

    // El correo tiene que estar verificado. La excepcion es Microsoft 365: Firebase
    // suele marcar esos correos como no verificados aunque vengan del directorio
    // de Claro. Se acepta solo con correo corporativo, y lo que garantiza que la
    // cuenta sea de Claro es que la aplicacion de Azure sea de un solo inquilino
    // (docs/ingreso-microsoft.md).
    function correoConfiable() {
      return request.auth.token.email_verified == true
        || (request.auth.token.firebase.sign_in_provider == 'microsoft.com'
            && esCorreoCorporativo());
    }

    // Invitaciones: un admin invita un correo (de cualquier dominio) y deja
    // listo su perfil. Para un correo externo, la invitacion vigente es lo que
    // lo deja entrar; revocarla le quita el acceso. Va al final del || de
    // dominioValido para que un correo corporativo no pague la lectura.
    function rutaInvitacion() {
      return /databases/$(database)/documents/invitaciones/$(correo().lower());
    }
    function invitado() {
      return correo() is string
        && exists(rutaInvitacion())
        && get(rutaInvitacion()).data.estado != 'revocada';
    }
    // El perfil nace con lo que dice la invitacion, ni mas ni menos.
    function calzaConInvitacion(d, inv) {
      return d.rol == inv.rol
        && d.get('celulaId', null) == inv.celulaId
        && d.get('proveedorId', null) == inv.proveedorId
        && d.get('alcance', null) == inv.alcance;
    }
    function comoInvitado(d) {
      return invitado() && calzaConInvitacion(d, get(rutaInvitacion()).data);
    }

    function rutaPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function existePerfil() {
      return exists(rutaPerfil());
    }

    function perfil() {
      return get(rutaPerfil()).data;
    }

    // Piso comun: corporativo, con perfil creado y no desactivado.
    function habilitado() {
      return dominioValido() && existePerfil() && perfil().activo == true;
    }

    function rol() {
      return perfil().rol;
    }

    function esAdmin() { return habilitado() && rol() == 'admin'; }
    function esJefe() { return habilitado() && rol() == 'jefe_celula'; }
    function esContratista() { return habilitado() && rol() == 'contratista'; }

    /** Roles que ven el despliegue completo. */
    function esInterno() {
      return habilitado() && rol() in ['admin', 'jefe_celula', 'analista', 'lector'];
    }

    /** Roles que pueden editar el avance. */
    function puedeGestionar() {
      return habilitado() && rol() in ['admin', 'jefe_celula', 'analista'];
    }

    function miProveedor() {
      return perfil().proveedorId;
    }

    function claves() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function soloCambia(permitidas) {
      return claves().hasOnly(permitidas);
    }

    function noCambia(campo) {
      return !(campo in claves());
    }

    // --------------------------------------------------------------- alcance
    // Un usuario no admin puede tener un alcance: listas de celulas, programas y
    // proyectos. Si alguna trae algo, solo ve y solo escribe los seguimientos
    // que caen en alguna de ellas (celula O programa O proyecto). Las tres
    // vacias, o el campo ausente (perfiles anteriores), es "sin restriccion".
    // Espejo en el cliente: src/domain/permisos/alcance.ts.
    //
    // Firestore evalua esto sobre la CONSULTA, no sobre los resultados: un
    // usuario acotado tiene que consultar con
    //   or(where('celulaId','in',C), where('programaId','in',P), where('proyectoId','in',Q))
    // (solo las listas no vacias) o la consulta completa falla. El repositorio
    // lo agrega siempre (consultaVisible en src/data/repos/sitioProyectos.ts).

    function listaAlcance(campo) {
      return perfil().get('alcance', {}).get(campo, []);
    }

    function sinAlcance() {
      return rol() == 'admin'
        || (listaAlcance('celulas').size() == 0
            && listaAlcance('programas').size() == 0
            && listaAlcance('proyectos').size() == 0);
    }

    function enAlcance(d) {
      return sinAlcance()
        || d.get('celulaId', null) in listaAlcance('celulas')
        || d.get('programaId', null) in listaAlcance('programas')
        || d.get('proyectoId', null) in listaAlcance('proyectos');
    }

    // Forma valida de un alcance al guardarlo: las tres listas y, en total, no
    // mas de 30 entradas, que es lo que admite un or() de Firestore. Con mas,
    // las consultas de ese usuario fallarian siempre.
    function alcanceValido(a) {
      return a is map
        && a.keys().hasOnly(['celulas', 'programas', 'proyectos'])
        && a.get('celulas', []) is list
        && a.get('programas', []) is list
        && a.get('proyectos', []) is list
        && a.get('celulas', []).size() + a.get('programas', []).size()
             + a.get('proyectos', []).size() <= 30;
    }

    function alcanceVacio(a) {
      return a == null
        || (a.get('celulas', []).size() == 0
            && a.get('programas', []).size() == 0
            && a.get('proyectos', []).size() == 0);
    }

    // ------------------------------------------------------------- auditoria
    // Append-only: nadie, ni un admin, edita o borra un evento. El unico camino
    // para corregir el historial es agregar un evento nuevo.

    match /auditoria/{eventoId} {
      allow get, list: if esInterno();

      allow create: if habilitado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == correo()
        && request.resource.data.ts == request.time
        && request.resource.data.entidadTipo is string
        && request.resource.data.entidadId is string
        && request.resource.data.accion is string
        && request.resource.data.origen in ['ui', 'import', 'seed'];

      allow update, delete: if false;
    }

    // -------------------------------------------------------------- usuarios

    match /usuarios/{uid} {
      // Cada uno lee su propio perfil (lo necesita para saber su rol).
      allow get: if autenticado() && request.auth.uid == uid;
      allow get, list: if esInterno();

      // Alta en el primer ingreso: entra como lector y nunca como algo más.
      // La única excepción son los correos de correosAdministradores(), que se
      // crean como admin: sin eso, una instalación nueva no tendría a nadie que
      // pudiera promover al primero.
      allow create: if dominioValido()
        && request.auth.uid == uid
        && request.resource.data.email == correo().lower()
        && request.resource.data.activo == true
        && (comoInvitado(request.resource.data)
            || ((request.resource.data.rol == 'lector'
                  || (esAdministradorInicial() && request.resource.data.rol == 'admin'))
                && request.resource.data.proveedorId == null
                && alcanceVacio(request.resource.data.get('alcance', null))));

      // El propio usuario solo puede refrescar su marca de ultimo acceso. En
      // particular, no toca su alcance: eso lo asigna un admin.
      allow update: if autenticado()
        && request.auth.uid == uid
        && soloCambia(['ultimoAcceso']);

      // Arranque, segunda parte: si el perfil ya existe con un rol menor (porque
      // la instalación se estrenó antes de agregar el correo a la lista, o porque
      // el cliente desplegado todavía no la traía), un correo de
      // correosAdministradores() corrige SU PROPIO rol a admin. Sin esto, la
      // persona que tiene que administrar la instalación queda atrapada como
      // lector y nadie puede promoverla, porque promover es cosa de un admin: el
      // arranque se rompe y la única salida es editar el documento a mano en la
      // consola. La lista vive en estas reglas, así que el permiso no lo concede
      // el cliente.
      allow update: if dominioValido()
        && esAdministradorInicial()
        && request.auth.uid == uid
        && request.resource.data.rol == 'admin'
        && soloCambia(['rol', 'actualizadoEn', 'actualizadoPor', 'ultimoAcceso']);

      // Un admin administra roles y alcances, pero no se quita a si mismo el
      // suyo por accidente: eso dejaria la instalacion sin administrador.
      allow update: if esAdmin()
        && (request.auth.uid != uid || request.resource.data.rol == 'admin')
        && (request.resource.data.rol != 'contratista'
            || request.resource.data.proveedorId is string)
        && (!('alcance' in request.resource.data)
            || alcanceValido(request.resource.data.alcance));

      // Los usuarios se desactivan (activo=false), no se borran: si no, su
      // rastro en la auditoria queda apuntando a la nada.
      allow delete: if false;
    }

    match /invitaciones/{correoId} {
      // El invitado lee la suya para armar su perfil en el primer ingreso.
      allow get: if esAdmin()
        || (autenticado() && correo() is string && correo().lower() == correoId);
      allow list: if esAdmin();

      allow create, update: if esAdmin()
        && request.resource.data.email == correoId
        && request.resource.data.rol in ['admin', 'jefe_celula', 'analista', 'contratista', 'lector']
        && request.resource.data.estado in ['pendiente', 'revocada']
        && (request.resource.data.rol != 'contratista'
            || request.resource.data.proveedorId is string)
        && alcanceValido(request.resource.data.alcance);

      // Al entrar, el invitado la marca aceptada. Nada mas.
      allow update: if autenticado()
        && correo() is string && correo().lower() == correoId
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado == 'aceptada'
        && soloCambia(['estado', 'aceptadaEn', 'uid']);

      allow delete: if esAdmin();
    }

    // -------------------------------------------------------------- catalogos

    match /celulas/{id} {
      allow get, list: if habilitado();
      allow write: if esAdmin();
    }

    // Areas que revisan etapas (OOCC, ECE, RF...) y quienes responden por
    // ellas. Las mantienen admin y jefe, igual que los proyectos: la asignacion
    // de personas cambia seguido y no deberia esperar a un administrador.
    match /areas/{id} {
      allow get, list: if esInterno();
      allow write: if esAdmin() || esJefe();
    }

    match /proveedores/{id} {
      allow get, list: if habilitado();
      allow write: if esAdmin();
    }

    match /portafolios/{id} {
      allow get, list: if esInterno();
      allow write: if esAdmin();
    }

    match /programas/{id} {
      allow get, list: if esInterno();
      allow write: if esAdmin();
    }

    match /proyectos/{id} {
      allow get, list: if esInterno();
      allow create, update: if esAdmin() || esJefe();
      allow delete: if esAdmin();
    }

    match /gateTemplates/{id} {
      allow get, list: if habilitado();
      allow write: if esAdmin();
    }

    // Registro de los correos de carpeta preparados para Power Automate: quien
    // pidio que y cuando. Se crea al preparar el correo y no se edita: es el
    // rastro. Solo quien gestiona sitios lo genera, y a su propio nombre.
    match /solicitudesCarpeta/{id} {
      allow get, list: if esInterno();
      allow create: if puedeGestionar()
        && request.resource.data.generadoPor == request.auth.uid
        && request.resource.data.estado == 'preparada'
        && request.resource.data.sitioId is string
        && request.resource.data.asunto is string
        && request.resource.data.asunto.size() <= 300;
      allow update: if false;
      allow delete: if esAdmin();
    }

    match /config/{id} {
      allow get, list: if esInterno();
      allow write: if esAdmin();
    }

    // ---------------------------------------------------------------- sitios

    match /sitios/{sitioId} {
      allow get, list: if habilitado();
      allow create, update: if puedeGestionar();
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------- sitioProyectos

    /**
     * Posicion de una etapa dentro de la secuencia DEL PROPIO DOCUMENTO.
     *
     * Antes esta funcion listaba las siete etapas del despliegue estandar. Ya no
     * puede: las etapas las define la plantilla de cada programa, y dos trackers
     * reales de la misma PMO tienen procesos distintos. Cada gate del documento
     * lleva su `orden` embebido justamente para esto, asi que la secuencia se lee
     * del dato y la regla vale para cualquier proceso sin un get() extra.
     *
     * CERRADO va despues de todo. Un codigo que el documento no tenga devuelve
     * -1, que no calza con ninguna comparacion y por lo tanto deniega.
     */
    function ordenEn(gates, g) {
      return g == 'CERRADO' ? 9999
        : (g in gates ? gates[g].orden : -1);
    }

    match /sitioProyectos/{spId} {

      function destino() { return request.resource.data.gateActual; }
      function origen() { return resource.data.gateActual; }

      // El gate solo se mueve al inmediatamente siguiente. Retroceder esta
      // reservado a admin y jefe de celula. (El admin, ademas, puede saltar:
      // ver la correccion administrativa en el allow update.)
      function gates() { return request.resource.data.gates; }

      /**
       * De donde sale la secuencia.
       *
       * Con `pasos` (etapa -> la que sigue, null en la ultima; las paralelas no
       * estan) se lee de ahi, del documento GUARDADO. Quien no es admin no
       * puede cambiar `pasos` (noCambia en el allow update), asi que nadie
       * puede alterar la secuencia para saltarse etapas: ni reescribiendo el
       * enlace en la misma escritura del avance, ni preparandolo antes.
       *
       * Sin `pasos` (documentos anteriores al campo, hasta que un admin los
       * complete desde Configuracion) se lee el enlace `siguiente` de cada gate
       * en el mapa que queda despues de la escritura, como antes. Eso deja la
       * puerta abierta a reescribir el enlace, por eso hay que completarlos.
       *
       * Por que un campo aparte y no revisar que el mapa de gates no cambie de
       * estructura: las reglas no recorren mapas, y revisarlo etapa por etapa
       * pasa el tope de 1.000 expresiones por escritura.
       */
      function tienePasos() { return resource.data.get('pasos', null) != null; }
      function pasos() { return resource.data.pasos; }
      function conoce(codigo) {
        return tienePasos() ? codigo in pasos() : codigo in gates();
      }
      function siguienteDe(codigo) {
        return tienePasos() ? pasos()[codigo] : gates()[codigo].siguiente;
      }
      // Una etapa que puede ser la actual: las paralelas no estan en `pasos`.
      function esEtapaSecuencial(codigo) {
        return tienePasos() ? codigo in pasos() : (codigo in gates() && noEsParalela(codigo));
      }

      function gateSecuencial() {
        return destino() == origen()
          || esSiguiente()
          || (esAnterior() && (esAdmin() || esJefe()));
      }

      /**
       * Cada etapa sabe cual le sigue. Sin ese enlace no habria forma de exigir
       * "la etapa inmediatamente siguiente": las reglas no recorren mapas, asi
       * que lo unico expresable seria "hacia adelante", y un salto de la
       * primera etapa a la ultima pasaria. Con el enlace la comprobacion es
       * exacta y de una sola lectura, para cualquier plantilla.
       */
      function esSiguiente() {
        return origen() != 'CERRADO'
          && conoce(origen())
          && (siguienteDe(origen()) == null
                ? destino() == 'CERRADO'
                : destino() == siguienteDe(origen()));
      }

      // Retroceder es el movimiento inverso: el destino es la etapa cuyo
      // siguiente es el origen (o la ultima, si se vuelve desde CERRADO).
      function esAnterior() {
        return destino() != 'CERRADO'
          && esEtapaSecuencial(destino())
          && (origen() == 'CERRADO'
                ? siguienteDe(destino()) == null
                : siguienteDe(destino()) == origen());
      }

      // Al avanzar, el gate que se deja atras queda cerrado de verdad: estado
      // completado y con fecha real. Sin esto se podria "avanzar" sin cerrar.
      function cierreConsistente() {
        return destino() == origen()
          || esAnterior()
          || (request.resource.data.gates[origen()].estado == 'completado'
              && request.resource.data.gates[origen()].fechaReal != null);
      }

      // El contratista puede reportar avance, pero no cambiar el compromiso ni
      // declarar cerrado el gate. Las reglas no recorren arreglos, asi que esto
      // fija el gate en curso (el que importa); el resto se valida en el
      // dominio y pasa al servidor en Fase 2.
      function contratistaNoTocaCompromiso() {
        let g = origen();
        return g == 'CERRADO'
          || (request.resource.data.gates[g].estado == resource.data.gates[g].estado
              && request.resource.data.gates[g].fechaPlan == resource.data.gates[g].fechaPlan
              && request.resource.data.gates[g].completadoPor == resource.data.gates[g].completadoPor);
      }

      // El contratista solo ve los sitios de su empresa. Firestore evalua esto
      // documento por documento, asi que sus consultas DEBEN traer el
      // where('proveedorId','==',...) o fallan completas (por diseno).
      //
      // Encima de eso, quien tenga alcance solo ve lo que cae en el (ver
      // enAlcance). Leer un id que no existe se permite: no revela nada, y el
      // alta lo necesita para saber si el sitio ya estaba en el proyecto.
      allow get: if (esInterno() && (resource == null || enAlcance(resource.data)))
        || (esContratista()
            && resource.data.proveedorId == miProveedor()
            && enAlcance(resource.data));

      allow list: if (esInterno() && enAlcance(resource.data))
        || (esContratista()
            && resource.data.proveedorId == miProveedor()
            && enAlcance(resource.data));

      allow create: if puedeGestionar()
        && enAlcance(request.resource.data)
        && request.resource.data.sitioId is string
        && request.resource.data.proyectoId is string
        && request.resource.data.programaId is string
        && request.resource.data.gateActual is string
        && ordenEn(request.resource.data.gates, request.resource.data.gateActual) >= 0;

      // Correccion administrativa: el admin puede llevar el sitio a CUALQUIER
      // etapa de su secuencia (saltando hacia adelante o hacia atras) sin la
      // exigencia de cierre. Existe para que un admin arregle el dato desde la
      // app —un tracker desfasado, una re-importacion que salta varias
      // etapas— sin que un desarrollador edite la base a mano. Sigue exigiendo
      // que el destino sea una etapa del propio documento (o CERRADO), y la
      // identidad del seguimiento no cambia ni para el admin.
      function destinoValido() {
        return ordenEn(gates(), destino()) >= 0
          && (destino() == 'CERRADO' || noEsParalela(destino()));
      }

      // Las etapas paralelas (FC, Contrato, Transmision...) tambien guardan
      // `siguiente: null`, igual que la ultima etapa de la secuencia. Sin esto,
      // "retroceder desde CERRADO" aceptaria mandar el sitio a una paralela, que
      // nunca puede ser la etapa actual.
      function noEsParalela(codigo) {
        return gates()[codigo].get('tipo', 'secuencial') != 'paralela';
      }

      // Un usuario acotado solo edita lo que esta en su alcance y no puede
      // sacarlo de el (por ejemplo, cambiandole la celula): se exige antes Y
      // despues de la escritura.
      allow update: if puedeGestionar()
        && enAlcance(resource.data)
        && enAlcance(request.resource.data)
        && noCambia('sitioId')
        && noCambia('proyectoId')
        && noCambia('programaId')
        && noCambia('portafolioId')
        && ((esAdmin() && destinoValido())
            || (noCambia('pasos') && gateSecuencial() && cierreConsistente()));

      allow update: if esContratista()
        && resource.data.proveedorId == miProveedor()
        && request.resource.data.proveedorId == miProveedor()
        && enAlcance(resource.data)
        && enAlcance(request.resource.data)
        && soloCambia(['gates', 'actualizadoEn', 'actualizadoPor'])
        && contratistaNoTocaCompromiso();

      allow delete: if esAdmin();

      match /comentarios/{comentarioId} {
        function padre() {
          return get(/databases/$(database)/documents/sitioProyectos/$(spId)).data;
        }

        // El alcance se mira en el padre: los comentarios de un seguimiento
        // fuera del alcance quedan tan fuera como el seguimiento. sinAlcance()
        // va primero para no pagar el get() cuando no hay restriccion.
        function padreEnAlcance() {
          return sinAlcance() || enAlcance(padre());
        }

        allow get, list: if (esInterno() && padreEnAlcance())
          || (esContratista() && padre().proveedorId == miProveedor() && padreEnAlcance());

        allow create: if habilitado()
          && rol() != 'lector'
          && padreEnAlcance()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.ts == request.time
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 4000;

        // Un comentario es parte del historial: no se edita, y no se borra
        // suelto. La unica excepcion es el admin eliminando el seguimiento
        // completo: el comentario solo se borra si su padre ya no existe
        // DESPUES de la escritura (en el mismo lote o en uno posterior). Asi
        // eliminar un seguimiento no deja comentarios huerfanos, y nadie puede
        // ir borrando comentarios incomodos de un sitio vivo.
        allow update: if false;
        allow delete: if esAdmin()
          && !existsAfter(/databases/$(database)/documents/sitioProyectos/$(spId));
      }
    }

    // ------------------------------------------------------- regulatorio

    // Expediente legal y regulatorio de un sitio al aire (terreno, DOM,
    // SUBTEL, recepcion). Un documento por seguimiento, con su mismo id. Lo
    // ven los internos de su alcance y lo marca quien gestiona el avance; el
    // contratista no entra: es trabajo de la PMO con los organismos.
    //
    // La identidad (sitio, proyecto, programa, celula) se compara con el
    // seguimiento en cada escritura: sin eso, alguien acotado podria colgar un
    // expediente de un proyecto que no le toca poniendo un proyectoId suyo.
    match /regulatorio/{spId} {
      function rutaSeguimiento() {
        return /databases/$(database)/documents/sitioProyectos/$(spId);
      }

      function calzaConSeguimiento(d) {
        let sp = get(rutaSeguimiento()).data;
        return d.sitioId == sp.sitioId
          && d.proyectoId == sp.proyectoId
          && d.programaId == sp.programaId
          && d.get('celulaId', null) == sp.get('celulaId', null);
      }

      function formaValida(d) {
        return d.keys().hasOnly(['sitioId', 'proyectoId', 'programaId', 'celulaId',
                                 'modalidad', 'items', 'actualizadoEn', 'actualizadoPor'])
          && d.get('items', {}) is map
          && d.get('modalidad', null) in [null, 'normal', 'concurso']
          && d.actualizadoPor == request.auth.uid
          && d.actualizadoEn == request.time;
      }

      allow get, list: if esInterno() && enAlcance(resource.data);

      allow create, update: if puedeGestionar()
        && exists(rutaSeguimiento())
        && formaValida(request.resource.data)
        && calzaConSeguimiento(request.resource.data)
        && enAlcance(request.resource.data)
        && (resource == null || enAlcance(resource.data));

      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------- tareas

    match /tareas/{tareaId} {
      allow get, list: if habilitado();
      allow create, update: if puedeGestionar();
      allow delete: if esAdmin() || esJefe();
    }

    // ------------------------------------------------------------ RAID (F2)

    match /raid/{raidId} {
      allow get, list: if esInterno();
      allow create, update: if puedeGestionar();
      allow delete: if esAdmin();
    }

    // Todo lo que no este declarado arriba queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
